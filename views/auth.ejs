<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GoldenHash Miner — Institutional Cloud Gold & SHA-256 Mining</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    .gold-glow {
      box-shadow: 0 0 60px -15px rgba(245, 158, 11, 0.35);
    }
    .grid-bg {
      background-image: radial-gradient(rgba(251, 191, 36, 0.12) 1px, transparent 1px);
      background-size: 28px 28px;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen grid-bg flex items-center justify-center p-4 lg:p-8">

  <div class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 bg-slate-900/90 backdrop-blur-xl border border-amber-500/20 rounded-3xl overflow-hidden gold-glow">
    
    <!-- Left Brand & Live Mining Preview Panel -->
    <div class="lg:col-span-6 p-8 sm:p-10 bg-gradient-to-br from-slate-900 via-slate-900 to-amber-950/50 border-b lg:border-b-0 lg:border-r border-slate-800 flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-400 to-yellow-600 flex items-center justify-center text-slate-950 text-xl font-extrabold shadow-lg shadow-amber-500/25">
            <i class="fa-solid fa-gem"></i>
          </div>
          <div>
            <span class="font-extrabold text-xl tracking-tight bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-500 bg-clip-text text-transparent">GOLDENHASH</span>
            <span class="block text-[10px] tracking-widest uppercase text-amber-400/80 font-semibold">Bullion & Hashrate Cloud</span>
          </div>
        </div>

        <h1 class="mt-8 text-3xl sm:text-4xl font-extrabold leading-tight text-white">
          Mine Digital Gold & USDT <span class="text-amber-400">24/7 Without Hardware.</span>
        </h1>
        <p class="mt-3 text-sm text-slate-400 leading-relaxed">
          Deploy enterprise SHA-256 & Gold-backed ASIC nodes in seconds. Every new miner receives an instant <strong class="text-amber-300">50 GH/s Free Cloud Rig</strong> upon registration.
        </p>

        <!-- Feature Badges -->
        <div class="mt-8 space-y-3.5">
          <div class="flex items-center gap-3.5 p-3 rounded-2xl bg-slate-950/60 border border-slate-800/80">
            <div class="w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center shrink-0">
              <i class="fa-solid fa-bolt"></i>
            </div>
            <div>
              <div class="text-xs font-bold text-white">Per-Second Real-Time Accrual</div>
              <div class="text-[11px] text-slate-400">Watch your USDT & Gold yield tick live every second</div>
            </div>
          </div>

          <div class="flex items-center gap-3.5 p-3 rounded-2xl bg-slate-950/60 border border-slate-800/80">
            <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-400 flex items-center justify-center shrink-0">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
              <div class="text-xs font-bold text-white">Multi-Chain Instant Settlement</div>
              <div class="text-[11px] text-slate-400">Supports USDT (TRC20 / BEP20), BTC & TRON</div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
        <span><i class="fa-solid fa-circle text-[8px] text-emerald-400 mr-1.5 animate-pulse"></i>Pool Uptime: 99.98%</span>
        <span class="mono text-amber-400 font-semibold">XAU/HASH ACTIVE</span>
      </div>
    </div>

    <!-- Right Auth Form Panel -->
    <div class="lg:col-span-6 p-8 sm:p-10 flex flex-col justify-center">
      
      <!-- Error Alert Banner -->
      <% if (error) { %>
        <div class="mb-5 p-3.5 rounded-xl bg-rose-500/15 border border-rose-500/40 text-rose-300 text-xs font-medium flex items-center gap-2.5">
          <i class="fa-solid fa-circle-exclamation text-rose-400 text-base shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- Sign in with Google Button -->
      <a href="/auth/google<%= ref ? '?ref=' + encodeURIComponent(ref) : '' %>" class="w-full py-3 px-4 rounded-xl bg-white hover:bg-slate-100 text-slate-900 font-bold text-sm transition flex items-center justify-center gap-3 shadow-md">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17Z"/>
          <path fill="#34A853" d="M12 24c3.3 0 6.08-1.09 8.1-2.96l-3.88-3.05c-1.1.74-2.51 1.18-4.22 1.18-3.24 0-5.99-2.19-6.97-5.13H1.02v3.14C3.05 21.2 7.24 24 12 24Z"/>
          <path fill="#FBBC05" d="M5.03 14.04c-.25-.74-.39-1.54-.39-2.36 0-.82.14-1.62.39-2.36V6.18H1.02C.37 7.47 0 8.93 0 10.48s.37 3.01 1.02 4.3l4.01-3.14Z"/>
          <path fill="#EA4335" d="M12 4.75c1.79 0 3.41.62 4.68 1.82l3.51-3.51C18.07 1.19 15.3 0 12 0 7.24 0 3.05 2.8 1.02 6.82l4.01 3.14c.98-2.94 3.73-5.21 6.97-5.21Z"/>
        </svg>
        <span>Continue with Google</span>
      </a>

      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-800"></div></div>
        <div class="relative flex justify-center text-[11px] uppercase tracking-wider">
          <span class="bg-slate-900 px-3 text-slate-500 font-semibold">Or use Email Credentials</span>
        </div>
      </div>

      <!-- Mode Switch Tabs -->
      <div class="grid grid-cols-2 gap-1.5 p-1 rounded-xl bg-slate-950 border border-slate-800 mb-6">
        <button type="button" onclick="switchMode('login')" id="btn-login" class="py-2 rounded-lg text-xs font-bold transition">Miner Login</button>
        <button type="button" onclick="switchMode('register')" id="btn-register" class="py-2 rounded-lg text-xs font-bold transition">Create Free Rig</button>
      </div>

      <!-- Login Form -->
      <form id="form-login" action="/auth/login" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">Email Address</label>
          <div class="relative">
            <i class="fa-solid fa-envelope absolute left-3.5 top-3.5 text-slate-500 text-xs"></i>
            <input type="email" name="email" required placeholder="miner@goldenhash.io" class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-amber-500 outline-none text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5">Password</label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-slate-500 text-xs"></i>
            <input type="password" name="password" id="login-pass" required placeholder="••••••••" class="w-full pl-10 pr-10 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-amber-500 outline-none text-sm" />
            <button type="button" onclick="togglePass('login-pass')" class="absolute right-3.5 top-3 text-slate-500 hover:text-slate-300 text-xs"><i class="fa-solid fa-eye"></i></button>
          </div>
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-extrabold text-sm shadow-lg shadow-amber-500/20 transition">
          Access Mining Console <i class="fa-solid fa-arrow-right ml-1.5"></i>
        </button>
      </form>

      <!-- Register Form -->
      <form id="form-register" action="/auth/register" method="POST" class="space-y-3.5 hidden">
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Miner Username</label>
          <div class="relative">
            <i class="fa-solid fa-user absolute left-3.5 top-3.5 text-slate-500 text-xs"></i>
            <input type="text" name="username" required minlength="3" placeholder="GoldMiner99" class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-amber-500 outline-none text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Email Address</label>
          <div class="relative">
            <i class="fa-solid fa-envelope absolute left-3.5 top-3.5 text-slate-500 text-xs"></i>
            <input type="email" name="email" required placeholder="you@example.com" class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-amber-500 outline-none text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Password (Min 6 Characters)</label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-slate-500 text-xs"></i>
            <input type="password" name="password" id="reg-pass" required minlength="6" placeholder="Create strong password" class="w-full pl-10 pr-10 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-amber-500 outline-none text-sm" />
            <button type="button" onclick="togglePass('reg-pass')" class="absolute right-3.5 top-3 text-slate-500 hover:text-slate-300 text-xs"><i class="fa-solid fa-eye"></i></button>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1">Referral Code (Optional)</label>
          <div class="relative">
            <i class="fa-solid fa-gift absolute left-3.5 top-3.5 text-slate-500 text-xs"></i>
            <input type="text" name="ref" value="<%= ref %>" placeholder="GHXXXXXX" class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-amber-500 outline-none text-sm uppercase mono" />
          </div>
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-yellow-500 hover:from-amber-400 hover:to-yellow-400 text-slate-950 font-extrabold text-sm shadow-lg shadow-amber-500/20 transition">
          Claim 50 GH/s & Start Mining <i class="fa-solid fa-bolt ml-1.5"></i>
        </button>
      </form>
    </div>
  </div>

  <script>
    function switchMode(mode) {
      const isReg = mode === 'register';
      document.getElementById('form-login').classList.toggle('hidden', isReg);
      document.getElementById('form-register').classList.toggle('hidden', !isReg);
      document.getElementById('btn-login').className = !isReg
        ? 'py-2 rounded-lg text-xs font-bold bg-amber-500 text-slate-950 shadow transition'
        : 'py-2 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition';
      document.getElementById('btn-register').className = isReg
        ? 'py-2 rounded-lg text-xs font-bold bg-amber-500 text-slate-950 shadow transition'
        : 'py-2 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition';
    }

    function togglePass(id) {
      const el = document.getElementById(id);
      el.type = el.type === 'password' ? 'text' : 'password';
    }

    switchMode('<%= mode %>');
  </script>
</body>
</html>
